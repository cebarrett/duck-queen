{
  "compilerOptions": {
    // Output a modern JS target; Vite handles the actual bundling.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Type-safety dial set to "helpful, not punishing".
    // `strict` is the big one: it catches the mistakes beginners actually hit
    // (null/undefined, wrong types) without any fancy type gymnastics from you.
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    // Vite-friendly settings. We don't emit .js from tsc (Vite does that);
    // tsc is only used to type-check.
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
